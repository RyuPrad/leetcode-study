{
  "number": 1971,
  "title": "Find if Path Exists in Graph",
  "spec": "leetcode",
  "statement": "An undirected graph has `n` vertices numbered `0` to `n - 1`. Each entry `[u, v]` of `edges` is an edge that can be travelled in both directions between `u` and `v`; no edge connects a vertex to itself, and no two edges join the same pair. Return `true` when you can walk along edges from `source` to `destination`, and `false` when you cannot. A vertex always reaches itself.",
  "constraints": [
    "1 <= n <= 2 * 10^5",
    "0 <= edges.length <= 2 * 10^5",
    "edges[i].length == 2",
    "0 <= u, v <= n - 1",
    "u != v (no self-loops)",
    "No pair of vertices appears in more than one edge",
    "0 <= source, destination <= n - 1"
  ],
  "signature": "boolean validPath(int n, int[][] edges, int source, int destination)",
  "entry": "validPath",
  "kind": "function",
  "parameters": [
    "n",
    "edges",
    "source",
    "destination"
  ],
  "languages": [
    "javascript",
    "typescript",
    "java",
    "c"
  ],
  "validator": "function validate([n, edges, source, destination]) {\n  if (n < 1 || n > 200000) return 'n is between 1 and 2 * 10^5.';\n  if (edges.length > 200000) return 'There are at most 2 * 10^5 edges.';\n  const seen = new Set();\n  for (const edge of edges) {\n    if (edge.length !== 2) return 'Each edge is a pair [u, v].';\n    const [u, v] = edge;\n    if (u < 0 || u >= n || v < 0 || v >= n) return 'Edge ends are vertices from 0 to n - 1.';\n    if (u === v) return 'An edge cannot join a vertex to itself.';\n    const key = Math.min(u, v) * n + Math.max(u, v);\n    if (seen.has(key)) return 'Two vertices share at most one edge.';\n    seen.add(key);\n  }\n  if (source < 0 || source >= n || destination < 0 || destination >= n) return 'source and destination are vertices from 0 to n - 1.';\n  return null;\n}",
  "reference": "function validPath(n, edges, source, destination) {\n  const graph = Array.from({ length: n }, () => []);\n  for (const [u, v] of edges) {\n    graph[u].push(v);\n    graph[v].push(u);\n  }\n  const seen = new Array(n).fill(false);\n  const stack = [source];\n  seen[source] = true;\n  while (stack.length > 0) {\n    const node = stack.pop();\n    if (node === destination) {\n      return true;\n    }\n    for (const next of graph[node]) {\n      if (!seen[next]) {\n        seen[next] = true;\n        stack.push(next);\n      }\n    }\n  }\n  return false;\n}",
  "brute": "function validPath(n, edges, source, destination) {\n  const reached = new Set([source]);\n  let changed = true;\n  while (changed) {\n    changed = false;\n    for (const [a, b] of edges) {\n      if (reached.has(a) !== reached.has(b)) {\n        reached.add(a);\n        reached.add(b);\n        changed = true;\n      }\n    }\n  }\n  return reached.has(destination);\n}",
  "generator": "function generate(rand, size) {\n  const n = size === 'large' ? 2000 : 1 + Math.floor(rand() * 8);\n  const edges = [];\n  if (size === 'large') {\n    // Two random trees over a shuffled vertex order, so some pairs connect and others do not.\n    const order = Array.from({ length: n }, (_, i) => i);\n    for (let i = n - 1; i > 0; i--) { const j = Math.floor(rand() * (i + 1)); [order[i], order[j]] = [order[j], order[i]]; }\n    const cut = 1 + Math.floor(rand() * (n - 1));\n    for (let i = 1; i < n; i++) if (i !== cut) { const low = i < cut ? 0 : cut; edges.push([order[i], order[low + Math.floor(rand() * (i - low))]]); }\n  } else {\n    const chance = rand() * 0.6;\n    for (let u = 0; u < n; u++) for (let v = u + 1; v < n; v++) if (rand() < chance) edges.push(rand() < 0.5 ? [u, v] : [v, u]);\n    for (let i = edges.length - 1; i > 0; i--) { const j = Math.floor(rand() * (i + 1)); [edges[i], edges[j]] = [edges[j], edges[i]]; }\n  }\n  return [n, edges, Math.floor(rand() * n), Math.floor(rand() * n)];\n}",
