  "compare": "checker",
  "checker": "function check([operations, args], actual, expected) {\n  const w = args[0][0];\n  if (!Array.isArray(actual) || actual.length !== operations.length || actual[0] !== null) return false;\n  const counts = w.map(() => 0);\n  for (let i = 1; i < actual.length; i++) {\n    const index = actual[i];\n    if (!Number.isInteger(index) || index < 0 || index >= w.length) return false;\n    counts[index]++;\n  }\n  const calls = actual.length - 1;\n  const total = w.reduce((sum, weight) => sum + weight, 0);\n  // A count of a fair choice with probability p over n tries stays within 5.5 standard deviations (+3 slack).\n  const fair = (seen, n, p) => Math.abs(seen - n * p) <= 5.5 * Math.sqrt(n * p * (1 - p)) + 3;\n  // Each index gets about its share; a chi-square over the well-filled indices adds power.\n  let chi = 0;\n  let cells = 0;\n  for (let i = 0; i < w.length; i++) {\n    const p = w[i] / total;\n    const mean = calls * p;\n    if (!fair(counts[i], calls, p)) return false;\n    if (mean >= 5) {\n      chi += (counts[i] - mean) ** 2 / mean;\n      cells++;\n    }\n  }\n  if (cells > 1 && chi > cells + 6 * Math.sqrt(2 * cells) + 8) return false;\n  return true;\n}",
  "validator": "function validate([operations, args]) {\n  if (!Array.isArray(operations) || operations[0] !== 'Solution' || !Array.isArray(args) || args.length !== operations.length) return 'Start with \"Solution\" and give one argument list per operation.';\n  if (!Array.isArray(args[0]) || args[0].length !== 1 || !Array.isArray(args[0][0])) return 'The constructor takes only w.';\n  const w = args[0][0];\n  if (w.length < 1 || w.length > 10000) return 'w needs 1 to 10^4 weights.';\n  if (w.some(v => !Number.isInteger(v) || v < 1 || v > 100000)) return 'Each weight is a whole number from 1 to 10^5.';\n  if (operations.length - 1 > 10000) return 'pickIndex is called at most 10^4 times.';\n  for (let i = 1; i < operations.length; i++) {\n    if (operations[i] !== 'pickIndex' || !Array.isArray(args[i]) || args[i].length !== 0) return 'After the constructor, only pickIndex() is called, with no arguments.';\n  }\n  return null;\n}",
  "languages": [
    "javascript",
    "typescript"
  ],
  "reference": "class Solution {\n  constructor(w) {\n    this.prefix = [];\n    let total = 0;\n    for (const weight of w) {\n      total += weight;\n      this.prefix.push(total);\n    }\n    this.total = total;\n  }\n\n  pickIndex() {\n    const target = Math.floor(Math.random() * this.total);\n    let left = 0;\n    let right = this.prefix.length - 1;\n    while (left < right) {\n      const mid = (left + right) >> 1;\n      if (this.prefix[mid] > target) {\n        right = mid;\n      } else {\n        left = mid + 1;\n      }\n    }\n    return left;\n  }\n}",
  "brute": "class Solution {\n  constructor(w) {\n    this.w = w.slice();\n  }\n  pickIndex() {\n    // Roll a real number in [0, sum) and walk the weights, subtracting each one until the roll fits.\n    let roll = Math.random() * this.w.reduce((sum, weight) => sum + weight, 0);\n    let i = 0;\n    while (i < this.w.length - 1 && roll >= this.w[i]) roll -= this.w[i++];\n    return i;\n  }\n}",
  "generator": "function generate(rand, size) {\n  const pick = k => Math.floor(rand() * k);\n  const large = size === 'large';\n  const n = large ? 1500 + pick(501) : 1 + pick(6);\n  const style = pick(3);\n  // 0: weights up to 10^5, 1: small weights, 2: one heavy index among light ones.\n  const heavy = pick(n);\n  const w = Array.from({ length: n }, (_, i) => {\n    if (style === 0) return 1 + pick(100000);\n    if (style === 1) return 1 + pick(10);\n    return i === heavy ? 50000 + pick(50001) : 1 + pick(large ? 100 : 3);\n  });\n  const calls = large ? 499 : 1 + pick(300);\n  return [[\"Solution\", ...Array(calls).fill(\"pickIndex\")], [[w], ...Array.from({ length: calls }, () => [])]];\n}",
