  "compare": "checker",
  "checker": "function check(input, actual, expected) {\n  const [ops, args] = input;\n  const nums = args[0][0];\n  const n = nums.length;\n  if (!Array.isArray(actual) || actual.length !== ops.length || actual[0] !== null) return false;\n  const original = JSON.stringify(nums);\n  const sorted = JSON.stringify([...nums].sort((a, b) => a - b));\n  const from = new Map(nums.map((value, i) => [value, i]));\n  const counts = nums.map(() => new Array(n).fill(0));\n  const seen = new Set();\n  let shuffles = 0;\n  let fixed = 0;\n  for (let i = 1; i < ops.length; i++) {\n    const out = actual[i];\n    if (!Array.isArray(out)) return false;\n    if (ops[i] === 'reset') {\n      if (JSON.stringify(out) !== original) return false;\n      continue;\n    }\n    // A shuffle must hold exactly the values of nums.\n    if (JSON.stringify([...out].sort((a, b) => a - b)) !== sorted) return false;\n    shuffles++;\n    seen.add(JSON.stringify(out));\n    out.forEach((value, p) => {\n      counts[from.get(value)][p]++;\n      if (from.get(value) === p) fixed++;\n    });\n  }\n  if (n >= 3 && shuffles >= 12 && seen.size === 1) return false;\n  if (n >= 2 && shuffles >= 50) {\n    // A fair shuffle leaves one value in place per call on average and spreads each value over every position.\n    if (Math.abs(fixed - shuffles) > 8 * Math.sqrt(shuffles)) return false;\n    const each = shuffles / n;\n    let spread = 0;\n    for (const row of counts) for (const c of row) spread += (c - each) ** 2 / each;\n    if (spread > n * (n - 1) + 25 * Math.sqrt(2 * n * (n - 1))) return false;\n  }\n  return true;\n}",
  "validator": "function validate([ops, args]) {\n  const nums = args[0][0];\n  if (nums.length < 1 || nums.length > 50) return 'nums needs 1 to 50 values.';\n  if (nums.some(v => v < -1000000 || v > 1000000)) return 'Each value is between -10^6 and 10^6.';\n  if (new Set(nums).size !== nums.length) return 'The values in nums must be distinct.';\n  if (ops.length - 1 > 10000) return 'At most 10^4 calls are allowed.';\n  return null;\n}",
  "languages": [
    "javascript",
    "typescript"
  ],
  "reference": "class Solution {\n  constructor(nums) {\n    this.original = nums.slice();\n  }\n\n  reset() {\n    return this.original.slice();\n  }\n\n  shuffle() {\n    const shuffled = this.original.slice();\n    for (let i = shuffled.length - 1; i > 0; i--) {\n      const j = Math.floor(Math.random() * (i + 1));\n      [shuffled[i], shuffled[j]] = [shuffled[j], shuffled[i]];\n    }\n    return shuffled;\n  }\n}",
  "brute": "class Solution {\n  constructor(nums) {\n    this.nums = [...nums];\n  }\n  reset() {\n    return [...this.nums];\n  }\n  shuffle() {\n    // Draw the next value uniformly from the ones not yet placed.\n    const pool = [...this.nums];\n    const out = [];\n    while (pool.length > 0) out.push(pool.splice(Math.floor(Math.random() * pool.length), 1)[0]);\n    return out;\n  }\n}",
  "generator": "function generate(rand, size) {\n  const pick = k => Math.floor(rand() * k);\n  const n = size === 'large' ? 50 : 1 + pick(6);\n  const span = size === 'large' || rand() < 0.5 ? 1000000 : 10;\n  const values = new Set();\n  while (values.size < n) values.add(pick(2 * span + 1) - span);\n  const count = size === 'large' ? 300 : pick(25);\n  const ops = ['Solution'], args = [[[...values]]];\n  for (let i = 0; i < count; i++) {\n    ops.push(rand() < 0.7 ? 'shuffle' : 'reset');\n    args.push([]);\n  }\n  return [ops, args];\n}",
